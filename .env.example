# Copy this file to .env (same folder) and fill in your own values.
# .env is gitignored — never commit real credentials.

# Postgres connection string (required). In production this is set for you
# automatically when you add the "Postgres" storage integration to your
# Vercel project (it appears as POSTGRES_URL). For local development, point
# this at the SAME database (recommended for a small team — everyone works
# against one source of truth) or a separate free Neon/Vercel Postgres
# branch. DATABASE_URL is also accepted as an alias, for portability to
# other hosts (Neon, Supabase, Railway).
POSTGRES_URL=

# Gmail account that sends user-invite emails (server/lib/email.js).
# Defaults to farmershelp.stock@gmail.com in code if left unset here.
EMAIL_USER=farmershelp.stock@gmail.com

# A Gmail *App Password* — NOT that account's normal login password.
# Gmail SMTP rejects normal passwords from apps like this one.
# 1. Turn on 2-Step Verification for the account (required first):
#    https://myaccount.google.com/signinoptions/two-step-verification
# 2. Generate an App Password for "Mail":
#    https://myaccount.google.com/apppasswords
# 3. Paste the 16-character code below (spaces don't matter).
# Leave this blank to run without real email — invites still work, the
# "email" just goes to the in-app Outbox only (Settings → Sent invitations).
EMAIL_APP_PASSWORD=

# Base URL used to build the activation link inside invite emails, so
# the link is clickable from an actual email client (not just relative
# to the app). In production, set this to your real Vercel URL
# (e.g. https://farmers-help.vercel.app).
APP_BASE_URL=http://localhost:5173

# Session-signing secret. Optional for local dev (a random one is generated
# each boot — sessions just reset when you restart the server). REQUIRED in
# production: without it, every cold start on Vercel would use a new random
# secret and invalidate everyone's session. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
